default_platform(:ios)

APP_IDENTIFIER    = "com.flim.app"
# The Live Activity widget extension — its own bundle id, App ID, and profile, same as the
# main app needs. Used in both match(...) calls and the beta lane's provisioningProfiles map
# below; project.yml embeds the target into the app. See docs/TESTFLIGHT_SETUP.md's "Adding a
# new target" for the one-time setup this already went through.
WIDGET_IDENTIFIER = "com.flim.app.RollActivityWidget"
# The notification service extension (1.6.3): puts a friend's photo into a push that carries
# reaction buttons. Same arrangement as the widget.
NOTIFICATION_SERVICE_IDENTIFIER = "com.flim.app.NotificationService"
ALL_IDENTIFIERS = [APP_IDENTIFIER, WIDGET_IDENTIFIER, NOTIFICATION_SERVICE_IDENTIFIER]
XCODEPROJ      = "Flim.xcodeproj"
SCHEME         = "Flim"

platform :ios do
  before_all do
    # On CI this creates an isolated temporary keychain so match can install the
    # signing identity without prompting. It's a no-op on local machines.
    setup_ci
  end

  # ---------------------------------------------------------------------------
  # Helpers
  # ---------------------------------------------------------------------------

  # The project is generated from project.yml, so regenerate it before building
  # to guarantee the .xcodeproj matches the source of truth.
  def regenerate_project
    sh("command -v xcodegen >/dev/null 2>&1 || brew install xcodegen")
    Dir.chdir("..") { sh("xcodegen generate") }
  end

  def asc_api_key
    require "base64"
    require "tmpdir"
    # Accept the ASC_KEY_P8 secret as either the raw .p8 PEM or a base64 blob of it
    # (line-wrapped or not), then hand fastlane a real file. This sidesteps the
    # strict base64 decoding in fastlane 2.236.x that raises "invalid curve name".
    raw = ENV.fetch("ASC_KEY_P8").strip
    pem = raw.include?("BEGIN") ? raw : Base64.decode64(raw)
    path = File.join(Dir.mktmpdir, "AuthKey.p8")
    File.write(path, pem)
    app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID").strip,
      issuer_id:    ENV.fetch("ASC_ISSUER_ID").strip,
      key_filepath: path,
      in_house:     false
    )
  end

  # ---------------------------------------------------------------------------
  # Lanes
  # ---------------------------------------------------------------------------

  desc "One-time, run locally: create the App Store signing cert + profile and push them to the match repo"
  desc "Pass force:true to REGENERATE profiles — needed after enabling a capability on an App ID,"
  desc "since an existing profile predates the capability and won't pick it up on its own."
  desc "Optionally pass app_identifier:<id> to regenerate just one instead of every id."
  lane :certificates do |options|
    api_key = asc_api_key
    identifiers = options[:app_identifier] ? [options[:app_identifier]] : ALL_IDENTIFIERS
    # A new extension's App ID, registered through the API key instead of the developer website.
    # Already registered is a no-op. Extensions here use no capabilities, so none are enabled.
    identifiers.each do |id|
      next if Spaceship::ConnectAPI::BundleId.find(id)
      Spaceship::ConnectAPI::BundleId.create(name: "FLIM #{id.split('.').last}", platform: "IOS", identifier: id)
      UI.success("Registered App ID #{id}")
    end
    # The bare `fastlane match` CLI can't do this: it has no App Store Connect API key, so it
    # falls back to asking for an Apple ID and dies with "Missing username" in a non-interactive
    # shell. Going through this lane is what supplies api_key.
    match(
      type:           "appstore",
      app_identifier: identifiers,
      api_key:        api_key,
      readonly:       false,
      force:          options[:force] || false
    )
  end

  desc "Build a signed Release archive and upload it to TestFlight"
  lane :beta do
    regenerate_project
    api_key = asc_api_key

    # Pull the shared distribution cert + profiles (read-only on CI). The app and each
    # embedded extension need their profile installed to archive.
    match(
      type:           "appstore",
      app_identifier: ALL_IDENTIFIERS,
      api_key:        api_key,
      readonly:       is_ci
    )

    # Next build number = highest already on TestFlight + 1 (App Store Connect
    # rejects duplicate build numbers). Falls back to 0 for a brand-new app.
    build_number = latest_testflight_build_number(
      app_identifier:       APP_IDENTIFIER,
      api_key:              api_key,
      initial_build_number: 0
    ) + 1
    UI.message("Building FLIM build ##{build_number}")

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"] ||
                   "match AppStore #{APP_IDENTIFIER}"
    widget_profile_name = ENV["sigh_#{WIDGET_IDENTIFIER}_appstore_profile-name"] ||
                          "match AppStore #{WIDGET_IDENTIFIER}"
    service_profile_name = ENV["sigh_#{NOTIFICATION_SERVICE_IDENTIFIER}_appstore_profile-name"] ||
                           "match AppStore #{NOTIFICATION_SERVICE_IDENTIFIER}"

    build_app(
      project:        XCODEPROJ,
      scheme:         SCHEME,
      configuration:  "Release",
      export_method:  "app-store",
      output_directory: "build",
      output_name:    "Flim.ipa",
      # Exactly the package versions in the committed Package.resolved, never newer ones picked
      # at archive time: what ships is what was built and tested.
      disable_package_automatic_updates: true,
      # Signing is configured on the app target in project.yml — passing it here
      # (globally) would force provisioning profiles onto SPM package targets and
      # fail the archive. Keep xcargs to just the build number.
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "-allowProvisioningUpdates"
      ].join(" "),
      export_options: {
        method:        "app-store",
        signingStyle:  "manual",
        teamID:        ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          APP_IDENTIFIER    => profile_name,
          WIDGET_IDENTIFIER => widget_profile_name,
          NOTIFICATION_SERVICE_IDENTIFIER => service_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key:                          api_key,
      app_identifier:                   APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,  # don't burn CI minutes waiting on Apple
      distribute_external:              false
    )
  end
end
