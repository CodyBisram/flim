# macOS
.DS_Store

# Xcode / build artifacts
.build/
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
Package.resolved

# CocoaPods / Carthage (unused, but safe to ignore)
Pods/
Carthage/Build/

# Editor / tooling
.claude/*
*.swp
*~

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/*.log
# Deliberately NOT tracked. CI pins ruby 3.3 (.github/workflows) and resolves its own deps
# via bundler-cache; a lock resolved against whatever ruby happens to be on a dev machine
# (e.g. 4.x, which writes "BUNDLED WITH 4.x") can fail that install outright.
Gemfile.lock
# Regenerated by fastlane on every lane run; the Fastfile's own desc lines are the source.
fastlane/README.md

# Secrets (none committed today, but keep them out)
*.p8
*.p12
*.mobileprovision
*.env
.env*

# Local clone of the private match repo (wiggapony0925/flim-certificates). Signing assets
# live in THEIR own repo, never nested in this one — fastlane clones MATCH_GIT_URL into a
# temp dir on its own and never reads this path. Kept ignored so a local checkout here
# can't be committed by accident.
/certs/

# LUT calibration photo pairs (docs/LUTS.md, scripts/fit_lut.py) — real photos of Cody's
# life, never belong in git history. Kept locally so a future refit can add more pairs
# without re-shooting the existing set.
/pairs/

# project agents + shared rules ship with the repo; local settings stay local
!.claude/agents/
!.claude/rules/

# Supabase CLI local link state (project ref, pooler URL, server versions).
# Machine-local, regenerated by `supabase link`, never source.
supabase/.temp/
