# macOS
.DS_Store

# Xcode / build artifacts
.build/
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
Package.resolved
# Except the app's own: it pins every package version, so a TestFlight build compiles exactly what
# was built and tested here, and CI refuses to resolve anything else (-disableAutomaticPackageResolution).
!Flim.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods / Carthage (unused, but safe to ignore)
Pods/
Carthage/Build/

# Editor / tooling
.claude/*
*.swp
*~

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/*.log
# Regenerated by fastlane on every lane run; the Fastfile's own desc lines are the source.
fastlane/README.md

# Secrets (none committed today, but keep them out)
*.p8
*.p12
*.mobileprovision
*.env
.env*

# Local clone of the private match repo (wiggapony0925/flim-certificates). Signing assets
# live in THEIR own repo, never nested in this one — fastlane clones MATCH_GIT_URL into a
# temp dir on its own and never reads this path. Kept ignored so a local checkout here
# can't be committed by accident.
/certs/

# LUT calibration photo pairs (docs/LUTS.md, scripts/fit_lut.py) — real photos of Cody's
# life, never belong in git history. Kept locally so a future refit can add more pairs
# without re-shooting the existing set.
/pairs/

# project agents + shared rules ship with the repo; local settings stay local
!.claude/agents/
!.claude/rules/
!.claude/skills/

# Supabase CLI local link state (project ref, pooler URL, server versions).
# Machine-local, regenerated by `supabase link`, never source.
supabase/.temp/
__pycache__/

# Local working output (financial model, screenshots, verification runs). This repo is public:
# nothing in here may ever be committed.
/outputs/

# Creator outreach batches name real people and the addresses they published. The repo is
# public, so they live only in the Pi's private archive (~/work/flim-ops/outreach/archive),
# which scripts/pi/outreach-weekly.sh copies in here for the length of a run.
/social/outreach/
